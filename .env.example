# Canonieke publieke herkomst
SITE_ORIGIN=https://www.dgwebservices.nl

# Alleen na expliciet launchbesluit op true zetten
ALLOW_INDEXING=false
APP_ENVIRONMENT=development

# Server-side contactaflevering; waarden horen als production secrets ingesteld te worden
CONTACT_DELIVERY_ENDPOINT=
CONTACT_DELIVERY_TOKEN=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Backoffice: vier publieke native Variables in GitHub environment production.
# Dit is het bevestigde productiedoel; gebruik voor staging een eigen project.
DGWEB_APP_ORIGIN=https://dgwebservices.nl/admin
DGWEB_DATA_MODE=supabase
NEXT_PUBLIC_SUPABASE_URL=https://prjvxusiqzadpaitcqxr.supabase.co
# Alleen de bestaande publishable key; geen secret/service_role key. Waarde niet committen.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
